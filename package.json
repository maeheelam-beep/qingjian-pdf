    "jszip": "3.10.1",
    "lucide-react": "0.525.0",
    "mammoth": "1.10.0",
    "pdfjs-dist": "4.10.38",
    "pptxgenjs": "3.12.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "38.8.6",
    "electron-builder": "26.0.12",
    "electron-vite": "3.1.0",
    "playwright-core": "1.55.0",
